{
  "manifest_version": 3,

  "name": "__MSG_extension_name__",
  "short_name": "__MSG_extension_short_name__",
  "description": "__MSG_extension_description__",
  "version": "1.0.5",
  "key": "",

  "default_locale": "ru",
  "icons": {
    "16": "src/icons/16.png",
    "48": "src/icons/48.png",
    "128": "src/icons/128.png",
    "256": "src/icons/256.png"
  },

  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://slay-award.ru/*",
    "https://www.slay-award.ru/*",
    "https://static.slay-award.ru/*",
    "https://media.slay-award.ru/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_winline_assets",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [{
    "matches": [
      "https://slay-award.ru/*",
      "https://www.slay-award.ru/*"
    ],
    "js": ["hide-cards.js"],
    "run_at": "document_idle"
  }]
}
